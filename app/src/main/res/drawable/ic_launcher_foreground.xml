        android:strokeWidth="7.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="25.5"
                android:endX="0" android:endY="82.5">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.28" android:color="#FFD5DBE3" />
                <item android:offset="0.47" android:color="#FF6E7884" />
